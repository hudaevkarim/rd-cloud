# ─── База данных ──────────────────────────────────────────────────────────────
# Кластер живёт в C:\rcdb\pgdata (НЕ в репозитории — Postgres не переваривает
# кириллицу в пути, см. tools/pg-start.ps1). Перед работой: .\tools\pg-start.ps1
DATABASE_URL="postgresql://rdcloud:__PGPASS__@127.0.0.1:5432/rdcloud?schema=public"

# ─── Приложение ───────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"
HOST="127.0.0.1"

# Уровень логов pino: trace | debug | info | warn | error | fatal.
# В development разумно "debug", в production — "info": на ноутбуке, который
# ещё и сервер, лишний вывод в консоль мешает.
LOG_LEVEL="debug"

# Каталог файлов книг, обложек и производных (главы, оглавление).
# Держим внутри репозитория: путь содержит кириллицу, но это чистый Node —
# он с такими путями работает. Проблема касается только самого Postgres.
DATA_DIR="./data"

# ─── Секретов для подписи нет ────────────────────────────────────────────────
# Сессия — это сам токен, который выдал админ: 32 байта, в базе лежит только
# sha256 от него. Подписывать нечего, поэтому SESSION_SECRET здесь не нужен.
# Если появятся cookie-сессии или JWT — секрет добавится здесь же.

# ─── Первый администратор (для prisma/seed.ts) ───────────────────────────────
# Если ADMIN_TOKEN пустой, seed сгенерирует токен и напечатает его один раз.
ADMIN_USERNAME="admin"
ADMIN_TOKEN=""
ADMIN_DISPLAY_NAME="Администратор"