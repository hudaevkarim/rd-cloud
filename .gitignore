# Зависимости
node_modules/

# Portable-тулчейн: Node лежит в репозитории, но в git ему не место —
# это ~94 МБ бинарей. Восстанавливается одной командой, см. README.
tools/node/

# Сборка
dist/
build/
*.tsbuildinfo

# Данные приложения: файлы книг, обложки, производные главы.
# В git не попадают никогда — это пользовательские данные.
data/

# Локальное окружение
.env
.env.local
.env.*.local

# Каталог файлов серверных тестов: там setup-файл держит DATA_DIR, чтобы тесты
# не писали в пользовательские данные.
.tmp-test-data/
packages/.tmp-test-data/

# Логи
*.log
logs/

# Отчёты и покрытие
coverage/
playwright-report/
test-results/
reports/

# Служебное
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Сгенерированный Prisma Client: Prisma 7 пишет TypeScript-исходники в проект
packages/server/src/generated/