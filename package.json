{
  "name": "rd-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Централизованное веб-приложение для совместного чтения книг и аудиокниг",
  "license": "MIT",
  "engines": {
    "node": ">=22.11 <23"
  },
  "workspaces": [
    "packages/library",
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build --workspace @rd/library",
    "build:all": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}