{
    "name":  "@rd/server",
    "version":  "0.1.0",
    "private":  true,
    "license":  "MIT",
    "type":  "module",
    "description":  "Fastify + Prisma + Socket.IO. Единственный источник правды.",
    "main":  "./dist/index.js",
    "scripts":  {
                    "dev":  "tsx watch src/index.ts",
                    "start":  "node dist/index.js",
                    "build":  "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
                    "db:migrate":  "prisma migrate dev",
                    "db:migrate:test":  "node scripts/migrate-test.mjs",
                    "db:seed":  "tsx src/prisma/seed.ts",
                    "db:reset":  "prisma migrate reset --force",
                    "db:studio":  "prisma studio",
                    "db:generate":  "prisma generate",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "test:socket":  "tsx scripts/socket-test.mts"
                },
    "prisma":  {
                   "schema":  "prisma/schema.prisma"
               },
    "dependencies":  {
                         "@fastify/cookie":  "^11.0.2",
                         "@fastify/cors":  "^11.1.0",
                         "@fastify/multipart":  "^9.2.1",
                         "@fastify/rate-limit":  "^10.3.0",
                         "@fastify/static":  "^8.2.0",
                         "@prisma/adapter-pg":  "7.10.0",
                         "@prisma/client":  "7.10.0",
                         "@rd/shared":  "^0.1.0",
                         "dotenv":  "^17.2.3",
                         "fastify":  "^5.6.1",
                         "pg":  "^8.16.3",
                         "pino":  "^9.13.1",
                         "socket.io":  "^4.8.4",
                         "zod":  "^4.1.12"
                     },
    "devDependencies":  {
                            "@rd/library":  "*",
                            "@types/node":  "^22.10.2",
                            "@types/pg":  "^8.15.5",
                            "esbuild":  "^0.25.0",
                            "pino-pretty":  "^13.1.2",
                            "prisma":  "7.10.0",
                            "socket.io-client":  "^4.8.4",
                            "tsx":  "^4.19.2",
                            "typescript":  "5.9.3"
                        }
}